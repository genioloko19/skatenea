# ==== AplicaciÃ³n ====
APP_NAME=SKATENEA
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
API_PREFIX=/api/v1
APP_TIMEZONE=UTC

# ==== Base de datos ====
# sqlite (desarrollo) | mysql (producciÃ³n / staging)
DB_DRIVER=sqlite
DB_SQLITE_PATH=../bd/skatenea.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=skatenea
DB_USER=skatenea_app
DB_PASS=
DB_CHARSET=utf8mb4
DB_SSL_CA=

# ==== JWT ====
# Generar con: php -r "echo bin2hex(random_bytes(48));"
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_64_BYTES_ALEATORIOS
JWT_ISSUER=skatenea-api
JWT_AUDIENCE=skatenea-client
JWT_ACCESS_TTL=900
JWT_LEEWAY=30

# ==== Cookies ====
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
REFRESH_TTL=2592000

# ==== CORS ====
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==== Seguridad ====
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=60
PASSWORD_MIN_LENGTH=12

# ==== Correo (fase 7) ====
# log = escribe en storage/logs/mail.log | smtp = envío real | null = desactivado
MAIL_DRIVER=log
MAIL_ENABLED=true
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@skatenea.local
MAIL_FROM_NAME=SKATENEA
MAIL_MAX_ATTEMPTS=5
PUBLIC_WEB_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=30

# ==== Webhooks e impresión (fase 7) ====
WEBHOOK_MAX_ATTEMPTS=5
# true solo en desarrollo; en producción debe ser false para mitigar SSRF
WEBHOOK_ALLOW_PRIVATE=true
# file = storage/prints | network = PRINT_HOST:PRINT_PORT | windows = recurso compartido | null
PRINT_DRIVER=file
PRINT_HOST=127.0.0.1
PRINT_PORT=9100
PRINT_WINDOWS_SHARE=POS-80

# ==== Seeds de desarrollo (NUNCA usar en producciÃ³n) ====
SEED_SUPER_ADMIN_EMAIL=admin@skatenea.local
SEED_SUPER_ADMIN_PASSWORD="Admin#2026!"
SEED_LEADER_EMAIL=lider@skatenea.local
SEED_LEADER_PASSWORD="Lider#2026!"
SEED_SELLER_EMAIL=vendedor@skatenea.local
SEED_SELLER_PASSWORD="Vendedor#2026!"
SEED_BUYER_EMAIL=comprador@skatenea.local
SEED_BUYER_PASSWORD="Comprador#2026!"
